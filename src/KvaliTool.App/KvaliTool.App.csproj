<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>KvaliTool.App</RootNamespace>
    <AssemblyName>KvaliTool</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Without this, "dotnet publish" leaves out KvaliTool.pri (and with it the compiled XAML), and the published
         app crashes at start (0xC000027B in Microsoft.UI.Xaml.dll) while the bin\ build runs fine. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Needed for the one Win32 window-subclass call that enforces the minimum window size (Native.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimmed publish: about a third of the size, so the launcher's download and unzip are that much faster.
         Setting it here also turns on the trim analyzers, so trim-unsafe code of our own fails the build.
         IL2104 is the one summary warning per assembly for WinRT.Runtime and Microsoft.Windows.SDK.NET (their
         reflection fallbacks, which x:Bind and the source-generated JSON never reach); it stays a warning. -->
    <PublishTrimmed>true</PublishTrimmed>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinUI part of the Windows App SDK only, not the Microsoft.WindowsAppSDK metapackage: that one also
         ships the AI/ML runtimes (onnxruntime, DirectML, ~40 MB) and Widgets, which this app never uses. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KvaliTool.Core\KvaliTool.Core.csproj" />
  </ItemGroup>

</Project>
