<Page
    x:Class="KvaliTool.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KvaliTool.App">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                x:Name="StatusBar"
                IsOpen="False"
                IsClosable="True" />

            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="Settings file: " /><Run x:Name="PathRun" />
            </TextBlock>

            <!-- Exclusions -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Always exclude"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Paths listed here are never shown in scan results. A plain path excludes that file or folder and everything inside it. Patterns with * and ? (for example *.psd) match the full path. Environment variables such as %USERPROFILE% work." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ExclusionBox"
                        Grid.Column="0"
                        PlaceholderText="Folder, file or pattern, for example D:\Projects"
                        AutomationProperties.Name="New exclusion path"
                        KeyDown="OnExclusionKeyDown" />
                    <Button
                        Grid.Column="1"
                        Content="Add"
                        Click="OnAddExclusionClick"
                        AutomationProperties.Name="Add exclusion" />
                </Grid>
                <TextBlock
                    x:Name="NoExclusionsText"
                    Text="No exclusions yet."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="ExclusionList" AutomationProperties.Name="Exclusions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ExclusionEntry">
                            <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind Value}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="1"
                                    Content="Remove"
                                    Click="OnRemoveExclusionClick"
                                    AutomationProperties.Name="{x:Bind RemoveName}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Thresholds -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Thresholds"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <NumberBox
                    x:Name="TempHoursBox"
                    Header="Temporary files: leave files changed in the last (hours)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    LargeChange="12"
                    AutomationProperties.Name="Temporary file minimum age in hours" />
                <NumberBox
                    x:Name="DownloadsDaysBox"
                    Header="Old downloads: untouched for at least (days)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    LargeChange="30"
                    AutomationProperties.Name="Old downloads minimum age in days" />
                <NumberBox
                    x:Name="LargeFileMbBox"
                    Header="Large files: bigger than (MB)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="100"
                    LargeChange="1024"
                    AutomationProperties.Name="Large file threshold in megabytes" />
                <NumberBox
                    x:Name="DuplicateKbBox"
                    Header="Duplicate files: ignore files smaller than (KB)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="64"
                    LargeChange="1024"
                    AutomationProperties.Name="Duplicate finder minimum size in kilobytes" />
                <NumberBox
                    x:Name="LogDaysBox"
                    Header="System logs: older than (days)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    LargeChange="30"
                    AutomationProperties.Name="Log minimum age in days" />
                <NumberBox
                    x:Name="RetentionDaysBox"
                    Header="Quarantine: keep removed items for (days), used from Phase 3"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="1"
                    LargeChange="7"
                    AutomationProperties.Name="Quarantine retention in days" />
            </StackPanel>

            <!-- Switches -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Options"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <ToggleSwitch
                    x:Name="FindDuplicatesSwitch"
                    Header="Find duplicates by default (slow)"
                    OnContent="On"
                    OffContent="Off"
                    AutomationProperties.Name="Find duplicates by default" />
                <ToggleSwitch
                    x:Name="ComponentStoreSwitch"
                    Header="Analyze the Windows component store when running as administrator"
                    OnContent="On"
                    OffContent="Off"
                    AutomationProperties.Name="Analyze component store" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="SaveButton"
                    Content="Save settings"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClick"
                    AutomationProperties.Name="Save settings" />
                <TextBlock
                    x:Name="SaveBlockedText"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
