<Page
    x:Class="KvaliTool.App.ResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KvaliTool.App"
    xmlns:sel="using:KvaliTool.Core.Selection"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- Right-click / context-menu key menu for item rows. Opened from OnRowContextRequested. -->
        <MenuFlyout x:Name="RowMenu">
            <MenuFlyoutItem x:Name="OpenLocationItem" Text="Open file location" Click="OnOpenLocationClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="CopyPathItem" Text="Copy path" Click="OnCopyPathClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="ExcludeItem" Text="Always exclude" Click="OnExcludeClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <Style x:Key="BadgeBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1,6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="MinHeight" Value="40" />
        </Style>

        <DataTemplate x:Key="RowTemplate" x:DataType="sel:ResultRow">
            <Grid ColumnSpacing="12" Padding="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" MinWidth="240" />
                    <ColumnDefinition Width="2*" MinWidth="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="3*" MinWidth="120" />
                </Grid.ColumnDefinitions>

                <!-- Name column: indent, expand/collapse chevron, tri-state checkbox, name and badges. -->
                <Grid Grid.Column="0" Margin="{x:Bind local:Fmt.Indent(Depth)}" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind local:Fmt.VisParent(Kind)}"
                        AutomationProperties.Name="{x:Bind local:Fmt.ExpandName(Name, IsExpanded), Mode=OneWay}"
                        Click="OnChevronClick">
                        <FontIcon Glyph="{x:Bind local:Fmt.Chevron(IsExpanded), Mode=OneWay}" FontSize="12" />
                    </Button>

                    <CheckBox
                        Grid.Column="1"
                        MinWidth="0"
                        Width="32"
                        VerticalAlignment="Center"
                        IsThreeState="True"
                        IsChecked="{x:Bind local:Fmt.Check(State), Mode=OneWay}"
                        IsEnabled="{x:Bind local:Fmt.CanSelect(IsSelectable, IsExcluded), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind local:Fmt.SelectName(Name)}"
                        Click="OnRowCheckClick" />

                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind local:Fmt.NameWithCount(Name, Kind, ItemCount)}"
                            TextWrapping="Wrap"
                            FontWeight="{x:Bind local:Fmt.NameWeight(Kind)}" />

                        <!-- Category status (icon + text) -->
                        <Border
                            Style="{StaticResource BadgeBorderStyle}"
                            Visibility="{x:Bind local:Fmt.VisCategoryStatus(Kind, Category.Status)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    Glyph="{x:Bind local:Fmt.StatusGlyph(Category.Status)}"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{x:Bind local:Fmt.StatusText(Category.Status)}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind local:Fmt.Vis(HasUnknownSize)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE9CE;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Size unknown" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind local:Fmt.VisReportOnly(Item)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                                <TextBlock Text="Report only" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind local:Fmt.Vis(IsPersonal)}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="Personal folder" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind local:Fmt.Vis(IsExcluded), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                <TextBlock Text="Excluded" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Warning / category caveat, visible without hovering -->
                        <Grid
                            ColumnSpacing="6"
                            Visibility="{x:Bind local:Fmt.VisText(Warning)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="14"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind local:Fmt.OrEmpty(Warning)}"
                                TextWrapping="Wrap"
                                FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:Fmt.OrEmpty(Path)}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind local:Fmt.OrEmpty(Path)}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind local:Fmt.SizeText(SizeBytes, HasUnknownSize, Kind)}"
                        TextWrapping="Wrap"
                        HorizontalTextAlignment="End" />
                    <TextBlock
                        Text="{x:Bind local:Fmt.SelectedText(SelectedBytes), Mode=OneWay}"
                        Visibility="{x:Bind local:Fmt.VisSelectedLine(Kind, SelectedBytes), Mode=OneWay}"
                        TextWrapping="Wrap"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:Fmt.DateText(LastModifiedUtc)}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="{x:Bind local:Fmt.OrEmpty(Reason)}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid" Padding="24,16,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shown until there are results -->
        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="0"
            Grid.RowSpan="2"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                Text="No results yet"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Run a scan on the Scan page to see what could be cleaned."
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Everything below is hidden until a tree is bound. -->
        <StackPanel x:Name="TopPanel" Grid.Row="0" Spacing="8" Visibility="Collapsed">
            <InfoBar
                x:Name="SavedReportBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False" />
            <InfoBar
                x:Name="PolicyBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="False"
                Title="The scanner reported a safety problem" />
            <InfoBar
                x:Name="DuplicateBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="True" />
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        x:Name="ReclaimableText"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SelectedText"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- A disabled control shows no tooltip, so the tooltip lives on a transparent wrapper. -->
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                    <Grid
                        Background="Transparent"
                        ToolTipService.ToolTip="Available in Phase 3"
                        AutomationProperties.Name="Clean selected items"
                        AutomationProperties.HelpText="Available in Phase 3">
                        <Button
                            x:Name="CleanButton"
                            Content="Clean selected"
                            IsEnabled="False"
                            AutomationProperties.Name="Clean selected items"
                            AutomationProperties.HelpText="Available in Phase 3" />
                    </Grid>
                    <TextBlock
                        Text="Cleaning arrives in Phase 3"
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="SortBox"
                    Grid.Column="0"
                    Header="Sort by"
                    MinWidth="190"
                    SelectedIndex="0"
                    SelectionChanged="OnSortChanged"
                    AutomationProperties.Name="Sort results by">
                    <ComboBoxItem Content="Size (largest first)" />
                    <ComboBoxItem Content="Name (A to Z)" />
                    <ComboBoxItem Content="Modified (newest first)" />
                    <ComboBoxItem Content="Modified (oldest first)" />
                    <ComboBoxItem Content="Scan order" />
                </ComboBox>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Header="Search (Ctrl+F)"
                    PlaceholderText="Name, path, reason or group"
                    TextChanged="OnSearchTextChanged"
                    AutomationProperties.Name="Search results" />
                <ToggleButton
                    x:Name="DetailsToggle"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Content="Details"
                    IsChecked="True"
                    Click="OnDetailsToggleClick"
                    AutomationProperties.Name="Show details pane" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Select safe items" Click="OnSelectSafeClick" AutomationProperties.Name="Select safe items" />
                <Button Content="Select all" Click="OnSelectAllClick" AutomationProperties.Name="Select all items" />
                <Button Content="Clear all" Click="OnClearAllClick" AutomationProperties.Name="Clear all selections" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="ListArea" Grid.Row="1" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- The list can be wider than the window: it scrolls sideways instead of cramping the columns. -->
            <ScrollViewer
                x:Name="ListScroll"
                Grid.Column="0"
                SizeChanged="OnListScrollSizeChanged"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid x:Name="ListContent" MinWidth="720" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12" Padding="8,4,8,4" AutomationProperties.AccessibilityView="Raw">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" MinWidth="240" />
                            <ColumnDefinition Width="2*" MinWidth="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="3*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" Margin="68,0,0,0" />
                        <TextBlock Grid.Column="1" Text="Path" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" HorizontalTextAlignment="End" />
                        <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Reason" FontWeight="SemiBold" />
                    </Grid>

                    <ListView
                        x:Name="RowList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        IsItemClickEnabled="False"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemContainerStyle="{StaticResource RowItemStyle}"
                        ContainerContentChanging="OnContainerContentChanging"
                        SelectionChanged="OnRowSelectionChanged"
                        ContextRequested="OnRowContextRequested"
                        AutomationProperties.Name="Scan results" />
                </Grid>
            </ScrollViewer>

            <!-- Details pane -->
            <Border
                x:Name="DetailsPane"
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock
                            Text="Details"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock
                            x:Name="NothingSelectedText"
                            Text="Select a row to see its details."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel x:Name="PreviewPanel" Spacing="4" Visibility="Collapsed">
                            <Image
                                x:Name="PreviewImage"
                                MaxHeight="240"
                                Stretch="Uniform"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                x:Name="PreviewText"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ItemsControl x:Name="DetailsList" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DetailField">
                                    <StackPanel Spacing="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind Value}"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
