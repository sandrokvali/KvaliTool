<Window
    x:Class="KvaliTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KvaliTool">

    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        OpenPaneLength="200"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False"
        SelectionChanged="OnNavSelectionChanged"
        Loaded="OnNavLoaded">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="ScanNavItem" Content="Scan" Tag="scan" AutomationProperties.Name="Scan">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ResultsNavItem" Content="Results" Tag="results" AutomationProperties.Name="Results">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FD;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings" AutomationProperties.Name="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown on every page when settings.json can't be read: scanning and saving settings are off. -->
            <StackPanel Grid.Row="0" Spacing="8">
                <InfoBar
                    x:Name="SettingsErrorBar"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="False"
                    Title="The settings file can't be read"
                    Margin="24,12,24,0" />
                <InfoBar
                    x:Name="NoticeBar"
                    Severity="Warning"
                    IsClosable="True"
                    IsOpen="False"
                    Margin="24,12,24,0" />
            </StackPanel>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
